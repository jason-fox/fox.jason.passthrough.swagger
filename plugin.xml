	<feature extension="dita.conductor.lib.import" file="lib/flexmark-util-visitor-0.64.8.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/annotations-24.0.1.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/passthrough.swagger-3.1.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/swagger-parser-1.0.53.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/swagger-core-1.6.1.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/swagger-models-1.6.1.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/swagger-annotations-1.6.1.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/swagger-parser-v3-2.0.24.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/swagger-parser-core-2.0.24.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/swagger-core-2.1.5.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/swagger-models-2.1.5.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/swagger-annotations-2.1.5.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/jackson-annotations-2.11.1.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/jackson-core-2.11.1.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/jackson-databind-2.11.1.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/jackson-dataformat-yaml-2.11.1.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/jackson-datatype-jsr310-2.11.1.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/snakeyaml-1.26.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/commons-io-2.4.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/commons-lang3-3.2.1.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/guava-27.0.1-android.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/failureaccess-1.0.1.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/listenablefuture-9999.0-empty-to-avoid-conflict-with-guava.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/jsr305-3.0.2.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/checker-compat-qual-2.5.2.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/error_prone_annotations-2.2.0.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/j2objc-annotations-1.1.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/animal-sniffer-annotations-1.17.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/slf4j-api-1.7.28.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/slf4j-ext-1.7.28.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/validation-api-1.1.0.Final.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/jakarta.xml.bind-api-2.3.2.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/jakarta.activation-api-1.2.1.jar"/>
	<feature extension="dita.conductor.lib.import" file="lib/jakarta.validation-api-2.0.2.jar"/>
	<feature extension="ant.import" file="process_swagger.xml"/>
	<!--
		The swagger CSS/FOP processing is used to display the colored bars
	-->
	<require plugin="fox.jason.extend.css"/>
	<require plugin="fox.jason.passthrough"/>

	<!-- PDF extension point -->
	<feature extension="dita.xsl.xslfo" value="xsl/xslfo.xsl" type="file"/>
	<!-- HTML5 extension points -->   
	<feature extension="dita.xsl.html5" value="xsl/xhtml.xsl" type="file"/>
	<feature extension="dita.xsl.xhtml" value="xsl/xhtml.xsl" type="file"/>

	<!-- Uses the Extended CSS extension point -->
	<feature extension="extend.css.process" value="swagger.css.copy"/>
	<!-- Uses the passthrough extension point and file reader -->
	<feature extension="dita.parser">
		<parser format="swagger" class="fox.jason.passthrough.SwaggerFileReader"/>
	</feature>
	<transtype name="base-html" abstract="true" desc="HTML-based output">
		<param
			name="swagger.css.theme"
			desc="Specifies the location of a custom .css color theme file for the HTTP verb colors."
			type="string"
		/>
	</transtype>
</plugin>
