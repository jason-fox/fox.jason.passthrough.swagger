      <fo:block>
        <fo:block border-after-color="black" font-family="STANDARD" font-weight="bold">
          <fo:block border-end-width="0pt">
            <fo:marker marker-class-name="current-h2">Overview</fo:marker>
            <fo:wrapper></fo:wrapper>
            <fo:wrapper></fo:wrapper>Overview</fo:block>
        </fo:block>
        <fo:block>
          <fo:block>This is a sample server Petstore server.  You can find out more about Swagger at
            <fo:basic-link color="#0d6efd" external-destination="url('http://swagger.io')" font-weight="inherit" text-decoration="none">http://swagger.io</fo:basic-link>or on
            <fo:basic-link color="#0d6efd" external-destination="url('http://swagger.io/irc/')" font-weight="inherit" text-decoration="none">irc.freenode.net, #swagger</fo:basic-link>.  For this sample, you can use the api key
            <fo:inline>special-key</fo:inline>to test the authorization filters.</fo:block>
          <fo:block>
            <fo:block font-family="STANDARD" font-weight="bold">Version information</fo:block>
            <fo:block>
              <fo:inline>Version</fo:inline>: 1.0.0</fo:block>
          </fo:block>
          <fo:block>
            <fo:block font-family="STANDARD" font-weight="bold">Contact information</fo:block>
            <fo:block>
              <fo:inline>Contact Email</fo:inline>: apiteam@swagger.io</fo:block>
          </fo:block>
          <fo:block>
            <fo:block font-family="STANDARD" font-weight="bold">License information</fo:block>
            <fo:block>
              <fo:inline>License</fo:inline>: Apache 2.0
              <fo:inline>License URL</fo:inline>: http://www.apache.org/licenses/LICENSE-2.0.html</fo:block>
          </fo:block>
          <fo:block>
            <fo:block font-family="STANDARD" font-weight="bold">URI scheme</fo:block>
            <fo:block>
              <fo:inline>Host</fo:inline>: petstore.swagger.io
              <fo:inline>BasePath</fo:inline>: /v2
              <fo:inline>Schemes</fo:inline>: HTTPS, HTTP</fo:block>
          </fo:block>
          <fo:block>
            <fo:block font-family="STANDARD" font-weight="bold">External Docs</fo:block>
            <fo:block>
              <fo:inline>Description</fo:inline>: Find out more about Swagger
              <fo:inline>URL</fo:inline>: http://swagger.io</fo:block>
          </fo:block>
        </fo:block>
      </fo:block>
