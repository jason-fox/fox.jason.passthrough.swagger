{
  "openapi": "3.0.3",
  "info": {
    "title": "Markdown Descriptions Example",
    "version": "1.0.0",
    "description": "Supports **bold**, `inline code` and lists:\n\n- First item\n- Second item"
  },
  "paths": {
    "/widgets/{widgetId}": {
      "get": {
        "operationId": "getWidget",
        "summary": "Get a widget",
        "description": "Returns a single widget. See `GET /widgets` for the **list** endpoint.",
        "parameters": [
          {
            "name": "widgetId",
            "in": "path",
            "required": true,
            "description": "The widget's `id`, as returned by `POST /widgets`.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "The requested widget." }
        }
      }
    }
  }
}
