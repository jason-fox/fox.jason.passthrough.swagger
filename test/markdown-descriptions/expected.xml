<?xml version="1.0" encoding="UTF-8" standalone="no"?>

<topic id="markdown-descriptions-example" outputclass="swagger">
  <title>Markdown Descriptions Example</title>
  <body>
    <object data="swagger/markdown.json" outputclass="swagger-spec" type="application/json"></object>
  </body>
  <topic id="overview">
    <title>Overview</title>
    <body>
      <p>Supports
        <b>bold</b>,
        <codeph>inline code</codeph>and lists:</p>
      <ul>
        <li>First item</li>
        <li>Second item</li>
      </ul>
      <section id="version-information" outputclass="section">
        <title outputclass="h5">Version information</title>
        <p>
          <i>Version</i>: 1.0.0</p>
      </section>
      <section id="uri-scheme" outputclass="section">
        <title outputclass="h5">URI scheme</title>
        <p>
          <i>BasePath</i>: /</p>
      </section>
    </body>
  </topic>
  <topic id="getwidget" outputclass="swagger-get">
    <title>Get a widget</title>
    <body>
      <codeblock outputclass="swagger-get">GET /widgets/{widgetId}</codeblock>
      <p>Returns a single widget. See
        <codeph>GET /widgets</codeph>for the
        <b>list</b>endpoint.</p>
      <section id="parameters" outputclass="section">
        <title>Parameters</title>
        <table>
          <tgroup cols="4">
            <colspec colname="col1" colnum="1"></colspec>
            <colspec colname="col2" colnum="2"></colspec>
            <colspec colname="col3" colnum="3"></colspec>
            <colspec colname="col4" colnum="4"></colspec>
            <thead>
              <row>
                <entry colname="col1">Type</entry>
                <entry colname="col2">Name</entry>
                <entry colname="col3">Description</entry>
                <entry colname="col4">Schema</entry>
              </row>
            </thead>
            <tbody>
              <row>
                <entry colname="col1">Path</entry>
                <entry colname="col2">
                  <lines>
                    <b>widgetId</b>
                    <i>required</i>
                  </lines>
                </entry>
                <entry colname="col3">The widget's
                  <codeph>id</codeph>, as returned by
                  <codeph>POST /widgets</codeph>.</entry>
                <entry colname="col4">string</entry>
              </row>
            </tbody>
          </tgroup>
        </table>
      </section>
      <section id="responses" outputclass="section">
        <title>Responses</title>
        <table>
          <tgroup cols="3">
            <colspec colname="col1" colnum="1"></colspec>
            <colspec colname="col2" colnum="2"></colspec>
            <colspec colname="col3" colnum="3"></colspec>
            <thead>
              <row>
                <entry colname="col1">HTTP Code</entry>
                <entry colname="col2">Description</entry>
                <entry colname="col3">Schema</entry>
              </row>
            </thead>
            <tbody>
              <row>
                <entry colname="col1">
                  <b>200</b>
                </entry>
                <entry colname="col2">The requested widget.</entry>
                <entry colname="col3">No Content</entry>
              </row>
            </tbody>
          </tgroup>
        </table>
      </section>
    </body>
  </topic>
</topic>

