<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project basedir="." default="unit-test">
	<import file="../bootstrap.xml"/>
	<description>
		Expect that an OpenAPI 3 file is parsed as well as Swagger 2.0.
	</description>
	<target name="unit-test">
		<property name="file" value="${basedir}/out/openapi.dita"/>
		<exec-transtype transtype="dita"/>
		<xmltask
      expandEntityReferences="false"
      dest="${file}"
      outputter="simple"
      source="${file}"
    >
			<xmlcatalog>
				<dtd publicId="-//OASIS//DTD DITA Topic//EN" location="../fake.dtd"/>
			</xmlcatalog>
		</xmltask>
		<compare-output suffix=".xml" result="${file}"/>
	</target>
</project>
