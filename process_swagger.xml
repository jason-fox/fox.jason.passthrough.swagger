<project
  name="fox.jason.passthrough.swagger"
  default="swagger.css.copy"
  xmlns:if="ant:if"
  xmlns:unless="ant:unless"
>

	<target name="swagger.css.copy">
		<property name="swagger.css.theme" value="${dita.plugin.fox.jason.passthrough.swagger.dir}/css/default-theme.css"/>
		<loadfile property="swagger.theme.css" srcFile="${swagger.css.theme}"/>
		<echo
      append="true"
      message="${line.separator}${swagger.theme.css}"
      file="${extend.css.file}"
    />
		<loadfile
      property="swagger.css"
      srcFile="${dita.plugin.fox.jason.passthrough.swagger.dir}/css/swagger.css"
    />
		<echo
      append="true"
      message="${line.separator}${swagger.css}"
      file="${extend.css.file}"
    />
	</target>

	<target name="swagger.spec.copy" if="passthrough.spec.keep">
		<copy todir="${dita.output.dir}" failonerror="false" overwrite="true">
			<fileset dir="${user.input.dir}" includes="**/*.yaml,**/*.yml,**/*.json">
				<present targetdir="${dita.temp.dir}"/>
				<containsregexp expression="^\s*[&quot;']?(swagger|openapi)[&quot;']?\s*:"/>
			</fileset>
			<regexpmapper from="^((?:.*/)?)([^/]+)$$" to="\1swagger/\2"/>
		</copy>
	</target>
</project>
